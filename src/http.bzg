// Include the BSL socket library (Installed via "bzg install socket")
include("lib/socket.bzg");  

// 1. Initialize Socket
if (socket_init() < 0) {
    print("Socket Initialization Failed\n");
} else {
    print("Socket Ready\n");
}

// 2. Create Socket Server
var server = socket_create();

if (server < 0) {
    print("Socket Creation Failed\n");
}

// 3. Bind Server to Port 8080
if (socket_bind(server, 0, 8080) < 0) {
    print("Socket Bind Failed.\n");
}

// 4. Listen for incoming connections
if (socket_listen(server, 5) < 0) {
    print("socket_listen() Failed.\n");
}

print("Server running on http://localhost:8080/\n");

while (true) {
    // 5. Accept Client Connection
    var client = socket_accept(server);
    print("Client connected!\n");

    var data = socket_read(client, 1024);

    if (sizeof(data) >= 0) {
        print("Received Request:\n" + data);
        var BODY = "";
        var HTTP = "";
        var match = regex("/.* HTTP/1.1", data);
        var path = substr(match, 0, sizeof(match) - 9);

        // Route Handling Logic
        if (path == "/") {
            BODY = "BSL Server - Home"
                + ""
                + "<h1>Welcome to BSL HTTP Server</h1>"
                + "<p>This is the default landing page served on route '/'</p>"
                + "";

            HTTP = "HTTP/1.1 200 OK\r\n"
                + "Content-Type: text/html\r\n"
                + "Content-Length: " + sizeof(BODY) + "\r\n"
                + "Connection: close\r\n\r\n";
        } else if (path == "/about") {
            BODY = "BSL Server - About"
                + ""
                + "<h1>About BSL HTTP Server</h1>"
                + "<p>This page contains information about the BSL HTTP Server project.</p>"
                + "";

            HTTP = "HTTP/1.1 200 OK\r\n"
                + "Content-Type: text/html\r\n"
                + "Content-Length: " + sizeof(BODY) + "\r\n"
                + "Connection: close\r\n\r\n";
        } else {
            BODY = "404 Not Found"
                + ""
                + "<h1>404 - Page Not Found</h1>"
                + "<p>The requested route does not exist on this BSL Server.</p>"
                + "";

            HTTP = "HTTP/1.1 404 Not Found\r\n"
                + "Content-Type: text/html\r\n"
                + "Content-Length: " + sizeof(BODY) + "\r\n"
                + "Connection: close\r\n\r\n";
        }

        var response = HTTP + BODY;
        socket_write(client, response, sizeof(response));
        socket_close(client);
    }
}